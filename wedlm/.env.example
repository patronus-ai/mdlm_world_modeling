# Copy to `.env` and fill in your own credentials. NEVER commit .env.
# `train.sh` sources this automatically if present.

# HuggingFace token — needed only to download gated/private models.
HF_TOKEN=

# Weights & Biases API key — needed only if `use_wandb: true` in your config.
WANDB_API_KEY=

# Optional: override the venv / WeDLM checkout locations used by the scripts.
# VENV_DIR=./.venv
# WEDLM_DIR=./WeDLM

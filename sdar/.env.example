# Copy to `.env` and fill in your own credentials. NEVER commit .env.
# `train_sft.sh` sources this automatically if present.

# HuggingFace token — only needed to download gated/private weights.
HF_TOKEN=

# Weights & Biases API key — only needed if `report_to: wandb` in the config.
WANDB_API_KEY=

# Optional: override venv / SDAR checkout locations.
# VENV_DIR=./.venv
# SDAR_DIR=./SDAR

# Copy to `.env` and fill in your own credentials. NEVER commit .env.
# `train.sh` and `eval.sh` source this file automatically if it exists.

# HuggingFace token — needed to download gated/private models or datasets.
HF_TOKEN=

# Weights & Biases API key — only needed if REPORT_TO=wandb (the default).
# Set REPORT_TO=none in your env to disable wandb entirely.
WANDB_API_KEY=

# Optional: override the venv location used by the shell scripts.
# VENV_DIR=./swift-venv

# Optional: GPU selection.
# CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
